---
import { ArrowUpRight } from '@lucide/astro';
import { SOCIAL } from '../../data/site';

const services = [
  { label: 'AI Chatbots', href: '/#services' },
  { label: 'Automation', href: '/#services' },
  { label: 'Software', href: '/#services' },
];

const company = [
  { label: 'Home', href: '/' },
  { label: 'Service', href: '/#services' },
  { label: 'About Us', href: '/about' },
];

// Social links open in a new tab when they are real links
const external = (href: string) =>
  href.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {};

// Shared styles
const cell = 'relative h-[300px] border-white lg:h-[304px]';
const textCell =
  'flex flex-col justify-end px-[38px] pb-[30px] text-white lg:px-[25px] lg:pb-[26px]';
const title = 'text-[32px] leading-tight font-normal';
const link = 'text-base font-light text-white/85 transition-opacity hover:opacity-70';
---

<footer class="relative isolate overflow-hidden bg-white">
  <!-- Background photo -->
  <img
    src="/images/footer_office.svg"
    alt=""
    aria-hidden="true"
    loading="lazy"
    decoding="async"
    class="absolute inset-0 -z-20 h-full w-full object-cover object-center"
  />

  <!-- White gradient: white at the top → transparent at the bottom -->
  <div
    class="absolute inset-x-0 top-0 -z-10 h-[55%] bg-gradient-to-b from-white to-transparent md:h-full"
    aria-hidden="true"
  ></div>

  <div
    class="mx-auto max-w-[1440px] px-4 pt-24 pb-4 md:px-8 md:pt-16 md:pb-10 lg:px-[58px] lg:pt-10"
  >
    <!-- Top: paragraph + logo -->
    <div
      class="flex flex-col gap-10 md:flex-row md:items-start md:justify-between md:gap-12"
    >
      <p
        data-reveal
           class="text-[20px] leading-[1.5] font-light text-[#5c6370] md:max-w-[560px] md:text-2xl md:text-ink/85 lg:max-w-[805px] lg:text-[30px]"
      >
        We are engineers, problem-solvers, and AI enthusiasts dedicated to building real-world
        solutions that drive business success. With a deep passion for smart, simple, and reliable
        technology, we help businesses work better in a fast-changing digital world.
      </p>

      <a data-reveal style="--reveal-delay: 150ms;" href="/" aria-label="ADIBID home" class="shrink-0">
        <img
          src="/images/adibid_black.svg"
          alt="ADIBID"
          width="352"
          height="76"
          loading="lazy"
          class="h-auto w-full md:w-[260px] lg:w-[352px]"
        />
      </a>
    </div>

    <!-- Table -->
    <div
      data-reveal
           style="--reveal-delay: 200ms;"
           class="mt-[42px] flex flex-col overflow-hidden rounded-b-[8px] border border-t-0 border-white lg:mt-[113px] lg:grid lg:grid-cols-4"
    >
      <!-- Row 1: empty boxes (mobile shows only the first one) -->
      <div class={`${cell} order-1 border-b lg:order-none lg:border-r`} aria-hidden="true"></div>
      <div class={`${cell} hidden lg:block lg:border-r lg:border-b`} aria-hidden="true"></div>
      <div class={`${cell} hidden lg:block lg:border-r lg:border-b`} aria-hidden="true"></div>
      <div class={`${cell} hidden lg:block lg:border-b`} aria-hidden="true"></div>

      <!-- Contact Us (white box) -->
      <a
        href="/contact"
        class={`${cell} group order-5 flex flex-col justify-end bg-white px-[38px] pb-[30px] lg:order-none lg:border-r lg:px-[25px] lg:pb-[26px]`}
      >
        <span class="flex items-center justify-between gap-4">
          <span>
            <span class={`${title} block text-[#333]`}>Contact Us</span>
            <span class="mt-2 block text-base font-light text-muted">
              Talk To Our Friendly Team
            </span>
          </span>
          <span
            class="flex h-[54px] w-[54px] shrink-0 items-center justify-center rounded-full border border-line text-ink transition group-hover:bg-ink group-hover:text-white"
          >
            <ArrowUpRight size={20} stroke-width={2} />
          </span>
        </span>
      </a>

      <!-- Services -->
      <div
        class={`${cell} ${textCell} order-4 border-b lg:order-none lg:border-r lg:border-b-0`}
      >
        <h2 class={title}>Services</h2>
        <nav class="mt-3 flex flex-wrap gap-x-2.5 gap-y-1" aria-label="Services">
          {services.map((s) => <a href={s.href} class={link}>{s.label}</a>)}
        </nav>
      </div>

      <!-- Company -->
      <div
        class={`${cell} ${textCell} order-3 border-b lg:order-none lg:border-r lg:border-b-0`}
      >
        <h2 class={title}>Company</h2>
        <nav class="mt-3 flex justify-between gap-3" aria-label="Company">
          {company.map((c) => <a href={c.href} class={link}>{c.label}</a>)}
        </nav>
      </div>

      <!-- Follow Us -->
      <div class={`${cell} ${textCell} order-2 border-b lg:order-none lg:border-b-0`}>
        <h2 class={title}>Follow Us</h2>
        <nav class="mt-3 flex flex-wrap gap-x-5 gap-y-1" aria-label="Social media">
          {
            SOCIAL.map((s) => (
              <a href={s.href} class={link} {...external(s.href)}>
                {s.label}
              </a>
            ))
          }
        </nav>
      </div>
    </div>
  </div>
</footer>