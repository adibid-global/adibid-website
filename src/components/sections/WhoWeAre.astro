---
// Second section of the Home page: company introduction card
---

<section
  id="about-intro"
  class="bg-white px-4 py-[60px] md:px-8 md:py-[100px] lg:px-12"
>
  <div
    data-reveal="zoom"
           class="relative isolate mx-auto flex min-h-[584px] max-w-[1344px] flex-col justify-end overflow-hidden rounded-[10px] bg-ink md:min-h-[410px]"
  >
    <!-- Background photo -->
    <img
      src="/images/office_area.webp"
      alt="ADIBID team working together in a modern office"
      loading="lazy"
      decoding="async"
      class="absolute inset-0 -z-20 h-full w-full object-cover object-[25%_center] md:object-center"
    />

    <!-- Black gradient: 100% black at the bottom → 0% at the top -->
   <div
  class="absolute inset-x-0 bottom-0 -z-10 h-[75%] bg-gradient-to-t from-black from-35% to-transparent md:h-[71%] md:from-0%"
  aria-hidden="true"
></div>

    <!-- Text -->
    <div data-reveal style="--reveal-delay: 250ms;" class="flex flex-col gap-4 px-[23px] py-8 text-white md:gap-3 md:p-10">
      <h2 class="text-[22px] leading-[1.45] font-semibold md:text-[40px] md:leading-[1.3]">
        Powering Businesses with AI &amp; Digital Innovation
      </h2>
      <p class="text-base leading-6 font-light md:text-2xl md:leading-[1.45] md:font-normal">
        At ADIBID Global, we provide AI automation and digital services designed to help businesses
        simplify operations, improve efficiency, and create smarter digital experiences. We combine
        artificial intelligence, automation, software development, and modern digital technologies
        to solve real business challenges.
      </p>
    </div>
  </div>
</section>